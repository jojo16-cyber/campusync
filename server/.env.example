# Server Environment Variables
PORT=5001
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/placement_portal)
MONGODB_URI=mongodb://localhost:27017/placement_portal

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Administrator Seed (optional, used by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@campasync.edu
ADMIN_PASSWORD=ChangeThisAdminPassword123!

